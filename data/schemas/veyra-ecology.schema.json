"{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://github.com/domogotu/video-game-/blob/main/data/schemas/veyra-ecology.schema.json\",\n  \"title\": \"Lethal Absorption Veyra Ecology Dataset\",\n  \"description\": \"Data contract for authored species, habitat anchors, and provisional ecological interactions. Schema validation does not imply simulation implementation.\",\n  \"type\": \"object\",\n  \"required\": [\"schema_version\", \"planet_id\", \"region_id\", \"evidence_policy\", \"habitats\", \"species\", \"interactions\", \"seasonal_scenarios\"],\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"schema_version\": { \"type\": \"string\", \"const\": \"1.0.0\" },\n    \"planet_id\": { \"type\": \"string\", \"const\": \"VEYRA\" },\n    \"region_id\": { \"type\": \"string\", \"const\": \"VEYRA-REEDWATER-BASIN\" },\n    \"evidence_policy\": {\n      \"type\": \"object\",\n      \"required\": [\"default_interaction_status\", \"implemented_requires_evidence\", \"tested_requires_evidence\"],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"default_interaction_status\": { \"type\": \"string\", \"const\": \"design_hypothesis\" },\n        \"implemented_requires_evidence\": { \"type\": \"boolean\", \"const\": true },\n        \"tested_requires_evidence\": { \"type\": \"boolean\", \"const\": true }\n      }\n    },\n    \"habitats\": {\n      \"type\": \"array\", \"minItems\": 1,\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\"id\", \"name\", \"conditions\", \"seasonal_pressures\"],\n        \"additionalProperties\": false,\n        \"properties\": {\n          \"id\": { \"type\": \"string\", \"pattern\": \"^VEY-START-[0-9]{2}$\" },\n          \"name\": { \"type\": \"string\", \"minLength\": 2 },\n          \"conditions\": { \"type\": \"array\", \"items\": { \"type\": \"string\" }, \"minItems\": 1 },\n          \"seasonal_pressures\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } }\n        }\n      }\n    },\n    \"species\": {\n      \"type\": \"array\", \"minItems\": 1,\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\"id\", \"name\", \"role\", \"habitat_ids\", \"design_status\", \"evidence_status\", \"resource_dependencies\"],\n        \"additionalProperties\": false,\n        \"properties\": {\n          \"id\": { \"type\": \"string\", \"pattern\": \"^LA-PLN-[A-Z]{3}-[0-9]{3}$\" },\n          \"name\": { \"type\": \"string\", \"minLength\": 2 },\n          \"role\": { \"type\": \"string\", \"minLength\": 2 },\n          \"habitat_ids\": { \"type\": \"array\", \"items\": { \"type\": \"string\", \"pattern\": \"^VEY-START-[0-9]{2}$\" }, \"minItems\": 1, \"uniqueItems\": true },\n          \"design_status\": { \"type\": \"string\", \"enum\": [\"candidate\", \"designed\", \"implemented\", \"tested\"] },\n          \"evidence_status\": { \"type\": \"string\", \"enum\": [\"design_only\", \"implementation_evidence\", \"test_evidence\"] },\n          \"resource_dependencies\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } }\n        },\n        \"allOf\": [\n          { \"if\": { \"properties\": { \"design_status\": { \"const\": \"candidate\" } }, \"required\": [\"design_status\"] }, \"then\": { \"properties\": { \"evidence_status\": { \"const\": \"design_only\" } } } },\n          { \"if\": { \"properties\": { \"design_status\": { \"const\": \"designed\" } }, \"required\": [\"design_status\"] }, \"then\": { \"properties\": { \"evidence_status\": { \"const\": \"design_only\" } } } },\n          { \"if\": { \"properties\": { \"design_status\": { \"const\": \"implemented\" } }, \"required\": [\"design_status\"] }, \"then\": { \"properties\": { \"evidence_status\": { \"enum\": [\"implementation_evidence\", \"test_evidence\"] } } } },\n          { \"if\": { \"properties\": { \"design_status\": { \"const\": \"tested\" } }, \"required\": [\"design_status\"] }, \"then\": { \"properties\": { \"evidence_status\": { \"const\": \"test_evidence\" } } } }\n        ]\n      }\n    },\n    \"interactions\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\"id\", \"type\", \"source_id\", \"target_id\", \"conditions\", \"status\", \"evidence\"],\n        \"additionalProperties\": false,\n        \"properties\": {\n          \"id\": { \"type\": \"string\", \"pattern\": \"^VEY-EDGE-[0-9]{3}$\" },\n          \"type\": { \"type\": \"string\", \"enum\": [\"consumes\", \"predates\", \"competes\", \"mutualism\", \"habitat_dependency\", \"material_flow\", \"behavioral_clue\"] },\n          \"source_id\": { \"type\": \"string\" },\n          \"target_id\": { \"type\": \"string\" },\n          \"conditions\": { \"type\": \"array\", \"items\": { \"type\": \"string\" }, \"minItems\": 1 },\n          \"status\": { \"type\": \"string\", \"enum\": [\"design_hypothesis\", \"mechanic_specified\", \"implemented\", \"tested\", \"rejected\"] },\n          \"evidence\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },\n          \"notes\": { \"type\": \"string\" }\n        }\n      }\n    },\n    \"seasonal_scenarios\": {\n      \"type\": \"array\", \"items\": {\n        \"type\": \"object\",\n        \"required\": [\"id\", \"name\", \"effects\", \"validation_expectations\"],\n        \"additionalProperties\": false,\n        \"properties\": {\n          \"id\": { \"type\": \"string\", \"pattern\": \"^VEY-SEASON-[0-9]{2}$\" },\n          \"name\": { \"type\": \"string\" },\n          \"effects\": { \"type\": \"array\", \"items\": { \"type\": \"string\" }, \"minItems\": 1 },\n          \"validation_expectations\": { \"type\": \"array\", \"items\": { \"type\": \"string\" }, \"minItems\": 1 }\n        }\n      }\n    }\n  }\n}"